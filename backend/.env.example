# Aldacore Backend Environment Variables

# App Configuration
APP_NAME=Aldacore
VERSION=1.0.0
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://aldacore:aldacore123@localhost:5432/aldacore

# Security Configuration
SECRET_KEY=aldacore-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ML Configuration
USE_MOCK_PREDICTIONS=true
PREDICTION_CONFIDENCE_THRESHOLD=0.7